# ---- LLM (Ollama) ----
# Ollama exposes an OpenAI-compatible endpoint at /v1.
# When the app runs in Docker and Ollama runs on the host, use host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama                 # dummy value; ollama ignores it
LLM_MODEL=gpt-oss:120b-cloud          # free Ollama cloud model (run `ollama signin` first)
EMBED_MODEL=nomic-embed-text          # 768-dim local embedding model
EMBED_DIM=768

# ---- Postgres (auth + relational + pgvector) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=csdap
POSTGRES_USER=csdap
POSTGRES_PASSWORD=csdap_dev_password
# Full URL derived from the above by config.py if unset:
# DATABASE_URL=postgresql://csdap:csdap_dev_password@postgres:5432/csdap

# ---- Neo4j (vector store) ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password

# ---- CSDA / Earthdata ----
# App-level defaults; users can also enter their own Earthdata creds in the UI.
CSDA_URL=https://csdap.earthdata.nasa.gov
CSDA_STAC_URL=https://csdap.earthdata.nasa.gov/api/v1/stac
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Where downloaded assets are written inside the container
DOWNLOAD_DIR=/data/downloads

# ---- Observability (Logfire) ----
# Leave token blank to run Logfire in local/console mode without sending data.
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=csdap-agent
LOGFIRE_SEND_TO_LOGFIRE=false

# ---- Chainlit auth ----
CHAINLIT_AUTH_SECRET=change-me-generate-with-`chainlit create-secret`
